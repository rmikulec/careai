# CareAI configuration. Copy to `.env` and fill in secrets; every value here has
# a working default in CareAI/config.py, so the app runs unconfigured for local
# dev. Field names map case-insensitively to the Settings model.

# Deployment environment label (development | staging | production).
ENVIRONMENT=development

# --- LLM -------------------------------------------------------------------
# Provider key read directly from the environment by langchain (not a Settings
# field). Required for any real agent turn.
OPENAI_API_KEY=
# Chat model id used by the reporting and escalation agents.
OPENAI_MODEL=gpt-5.6-luna
# Reasoning effort: minimal | low | medium | high (higher = deeper but slower).
LLM_REASONING_EFFORT=medium
# Times the chat model retries a failed request (transient errors / rate limits)
# before giving up.
LLM_MAX_RETRIES=2
# Max LangGraph super-steps for a single agent turn before a GraphRecursionError
# is raised (bounds a looping graph).
AGENT_RECURSION_LIMIT=25

# --- Auth & CORS -----------------------------------------------------------
# Accepted X-API-Key values, comma-separated.
API_KEYS=dev-local-key
# Allowed CORS origins, comma-separated.
CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# SQLAlchemy async connection URL for Postgres + pgvector.
DATABASE_URL=postgresql+asyncpg://florence:florence@localhost:5432/florence

# --- Observability (self-hosted OTEL; no PHI leaves the boundary) ----------
# Off by default so local runs and tests don't reach for an exporter.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=careai-api

# --- Streamlit UI client ---------------------------------------------------
# Base URL and key the Streamlit UI uses to call the API.
CAREAI_API_URL=http://localhost:8000
CAREAI_API_KEY=dev-local-key
