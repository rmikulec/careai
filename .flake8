[flake8]
max-line-length = 88
extend-ignore = E203, W503
per-file-ignores =
    # Prompt text and tool docstrings are LLM-facing messages that black cannot
    # wrap; black still enforces 88 for all actual code in these modules.
    CareAI/agents/reporting/prompts.py: E501
    CareAI/agents/reporting/tools.py: E501
